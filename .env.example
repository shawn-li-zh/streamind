# ===== 复制此文件为 .env 后填写（.env 已被 git 忽略，请勿提交）=====

# 数据库（SQLite + sqlite-vec）
DATABASE_URL=sqlite://streamind.db?mode=rwc

# 【必填】JWT 签名密钥：请生成 32 位以上随机字符串，缺失会导致启动失败
# 例：openssl rand -hex 32  或  -join ((48..57)+(97..102) | Get-Random -Count 32 | % {[char]$_})
JWT_SECRET_KEY=
JWT_EXPIRATION_MINUTES=600

# 【必填】服务端口与对外地址
PORT=3000
BASE_URL=http://localhost:3000

# 【必填】向量（嵌入）模型：火山方舟 doubao-embedding-vision
# 注意 EMBEDDING_DIM 必须与 sql/init.vec.sql 中的 FLOAT[1024] 一致
EMBEDDING_API_KEY=
EMBEDDING_API_URL=https://ark.cn-beijing.volces.com/api/v3/embeddings/multimodal
EMBEDDING_MODEL=doubao-embedding-vision-251215
EMBEDDING_DIM=1024

# 浏览器工具使用的 Chrome 路径（Windows 示例，注意双反斜杠）
CHROME_PATH="C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"

# ===== 可选：以下缺省时使用代码内默认值 =====
# HEARTBEAT_INTERVAL=30s
# CONTEXT_SIZE_LIMIT=...
# TOOL_CALL_TIME_OUT=...
# TOOL_RESULT_SIZE_LIMIT=...

# ===== 注意 =====
# 大模型的 api_key 不放在这里，而是存在数据库的 model 表（可从前端「模型」页或 SQL 维护）。
