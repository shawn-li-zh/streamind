// 1. 定义内置的空白符规则，pest 会自动在各个规则之间忽略这些空白符
WHITESPACE = _{ " " | "\t" | "\r" | "\n" }

// 2. 关键字定义
keyword = { "include" | "match" | "ccc" }

// 3. 字符串定义（例如 "any"）
// 使用 $ 符号（复合原子规则）和 @ 符号（原子规则），确保字符串内部的空格不会被当做语法空白符忽略
string = ${ "\"" ~ inner ~ "\"" }
inner  = @{ (!"\"" ~ ANY)* }

// 4. 谓词/函数调用定义，例如 aaa("any")
predicate = { keyword ~ "(" ~ string ~ ")" }
boolean={"true"|"false"}
// 5. 表达式定义 (使用递归下降处理逻辑运算符的优先级: 括号 > 非 > 与 > 或)

not_op = { "!" } // 提取为显式规则，方便在 Rust 中识别

// primary 被标记为静默规则 `_`，这样它会直接透传出内部的 predicate 或 or_expr
primary = _{boolean| predicate | "(" ~ or_expr ~ ")" }

unary_expr = { not_op* ~ primary }
and_expr = { unary_expr ~ ("&" ~ unary_expr)* }
or_expr = { and_expr ~ ("|" ~ and_expr)* }


// 6. 程序的入口点，SOI 表示文件开始，EOI 表示文件结束
main = _{ SOI ~ or_expr ~ EOI }