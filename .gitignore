# ===== 构建产物 =====
/target
# 打包脚本的输出目录
/dist

# ===== 前端依赖与产物（web_ui / web_render 各自也有 .gitignore，这里做兜底）=====
node_modules/
.pnpm-store/
web_ui/dist/
web_render/dist/

# ===== 编辑器 =====
/.idea
/.vscode

# Cargo.lock 对二进制应用应当提交，故不忽略

# ===== 密钥与本地配置（严禁提交）=====
/.env
/.env.*
!/.env.example

# ===== 运行时数据（含 API Key、对话记录、浏览器 profile）=====
/workspace
/public
/tempb
*.db
*.db-journal
*.db-wal
*.db-shm
